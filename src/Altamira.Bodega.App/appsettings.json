{
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSegundos": 30
  },
  "Jwt": {
    "Issuer": "FarmacosAltamira",
    "Audience": "FarmacosAltamiraApi"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs\\bodega-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7 } }
    ]
  },
  "AllowedHosts": "*"
}
