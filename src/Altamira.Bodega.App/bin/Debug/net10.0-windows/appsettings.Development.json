{
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSegundos": 30
  },
  "Jwt": {
    "Issuer": "FarmacosAltamira-Dev",
    "Audience": "FarmacosAltamiraApi-Dev",
    "ClaveSecreta": "Desarrollo-Clave-Secreta-No-Usar-En-Produccion-12345"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs\\bodega-dev-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7 } }
    ]
  },
  "AllowedHosts": "*"
}
