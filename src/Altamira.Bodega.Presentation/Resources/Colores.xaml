<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         PALETA CROMÁTICA INSTITUCIONAL - FÁRMACOS ALTAMIRA
         ================================================================ -->

    <!-- Colores primarios -->
    <Color x:Key="ColorPrimario">#1E3A5F</Color>
    <Color x:Key="ColorPrimarioOscuro">#14304F</Color>
    <Color x:Key="ColorPrimarioClaro">#2E5A8A</Color>
    <Color x:Key="ColorSecundario">#0E7C7B</Color>
    <Color x:Key="ColorSecundarioClaro">#14B8A6</Color>

    <!-- Colores de estado -->
    <Color x:Key="ColorExito">#10B981</Color>
    <Color x:Key="ColorExitoClaro">#D1FAE5</Color>
    <Color x:Key="ColorAdvertencia">#F59E0B</Color>
    <Color x:Key="ColorAdvertenciaClaro">#FEF3C7</Color>
    <Color x:Key="ColorPeligro">#EF4444</Color>
    <Color x:Key="ColorPeligroClaro">#FEE2E2</Color>
    <Color x:Key="ColorInformacion">#3B82F6</Color>
    <Color x:Key="ColorInformacionClaro">#DBEAFE</Color>

    <!-- Colores de superficie -->
    <Color x:Key="ColorFondo">#F8FAFC</Color>
    <Color x:Key="ColorSuperficie">#FFFFFF</Color>
    <Color x:Key="ColorSuperficieSecundaria">#F1F5F9</Color>
    <Color x:Key="ColorBorde">#E2E8F0</Color>
    <Color x:Key="ColorBordeClaro">#CBD5E1</Color>

    <!-- Colores de texto -->
    <Color x:Key="ColorTextoPrimario">#0F172A</Color>
    <Color x:Key="ColorTextoSecundario">#475569</Color>
    <Color x:Key="ColorTextoSuave">#64748B</Color>
    <Color x:Key="ColorTextoInverso">#FFFFFF</Color>

    <!-- Colores de inventario -->
    <Color x:Key="ColorStockDisponible">#10B981</Color>
    <Color x:Key="ColorStockBajo">#F59E0B</Color>
    <Color x:Key="ColorStockCaducado">#EF4444</Color>
    <Color x:Key="ColorStockProximo">#8B5CF6</Color>
    <Color x:Key="ColorStockSinDatos">#94A3B8</Color>

    <!-- ================================================================
         PINCELES (BRUSHES)
         ================================================================ -->

    <SolidColorBrush x:Key="BrochaPrimaria" Color="{DynamicResource ColorPrimario}" />
    <SolidColorBrush x:Key="BrochaPrimariaOscura" Color="{DynamicResource ColorPrimarioOscuro}" />
    <SolidColorBrush x:Key="BrochaPrimariaClara" Color="{DynamicResource ColorPrimarioClaro}" />
    <SolidColorBrush x:Key="BrochaSecundaria" Color="{DynamicResource ColorSecundario}" />
    <SolidColorBrush x:Key="BrochaSecundariaClara" Color="{DynamicResource ColorSecundarioClaro}" />

    <SolidColorBrush x:Key="BrochaExito" Color="{DynamicResource ColorExito}" />
    <SolidColorBrush x:Key="BrochaExitoClara" Color="{DynamicResource ColorExitoClaro}" />
    <SolidColorBrush x:Key="BrochaAdvertencia" Color="{DynamicResource ColorAdvertencia}" />
    <SolidColorBrush x:Key="BrochaAdvertenciaClara" Color="{DynamicResource ColorAdvertenciaClaro}" />
    <SolidColorBrush x:Key="BrochaPeligro" Color="{DynamicResource ColorPeligro}" />
    <SolidColorBrush x:Key="BrochaPeligroClara" Color="{DynamicResource ColorPeligroClaro}" />
    <SolidColorBrush x:Key="BrochaInformacion" Color="{DynamicResource ColorInformacion}" />
    <SolidColorBrush x:Key="BrochaInformacionClara" Color="{DynamicResource ColorInformacionClaro}" />

    <SolidColorBrush x:Key="BrochaFondo" Color="{DynamicResource ColorFondo}" />
    <SolidColorBrush x:Key="BrochaSuperficie" Color="{DynamicResource ColorSuperficie}" />
    <SolidColorBrush x:Key="BrochaSuperficieSecundaria" Color="{DynamicResource ColorSuperficieSecundaria}" />
    <SolidColorBrush x:Key="BrochaBorde" Color="{DynamicResource ColorBorde}" />
    <SolidColorBrush x:Key="BrochaBordeClaro" Color="{DynamicResource ColorBordeClaro}" />

    <SolidColorBrush x:Key="BrochaTextoPrimario" Color="{DynamicResource ColorTextoPrimario}" />
    <SolidColorBrush x:Key="BrochaTextoSecundario" Color="{DynamicResource ColorTextoSecundario}" />
    <SolidColorBrush x:Key="BrochaTextoSuave" Color="{DynamicResource ColorTextoSuave}" />
    <SolidColorBrush x:Key="BrochaTextoInverso" Color="{DynamicResource ColorTextoInverso}" />

    <SolidColorBrush x:Key="BrochaStockDisponible" Color="{DynamicResource ColorStockDisponible}" />
    <SolidColorBrush x:Key="BrochaStockBajo" Color="{DynamicResource ColorStockBajo}" />
    <SolidColorBrush x:Key="BrochaStockCaducado" Color="{DynamicResource ColorStockCaducado}" />
    <SolidColorBrush x:Key="BrochaStockProximo" Color="{DynamicResource ColorStockProximo}" />
    <SolidColorBrush x:Key="BrochaStockSinDatos" Color="{DynamicResource ColorStockSinDatos}" />

    <!-- ================================================================
         TIPGRAFÍA
         ================================================================ -->

    <FontFamily x:Key="FuentePrincipal">Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteTitulos">Segoe UI Semibold</FontFamily>

    <sys:Double x:Key="TamanoTextoTituloGrande">24</sys:Double>
    <sys:Double x:Key="TamanoTextoTituloMedio">20</sys:Double>
    <sys:Double x:Key="TamanoTextoTituloPequeno">16</sys:Double>
    <sys:Double x:Key="TamanoTextoNormal">14</sys:Double>
    <sys:Double x:Key="TamanoTextoPequeno">12</sys:Double>
    <sys:Double x:Key="TamanoTextoMuyPequeno">11</sys:Double>

    <!-- ================================================================
         ESPACIADOS
         ================================================================ -->

    <Thickness x:Key="MargenPagina">24</Thickness>
    <Thickness x:Key="MargenSeccion">16</Thickness>
    <Thickness x:Key="MargenComponente">12</Thickness>
    <Thickness x:Key="RellenoTarjeta">16</Thickness>
    <Thickness x:Key="EspaciadoFilaTabla">8</Thickness>

    <!-- ================================================================
         RADIOS DE BORDE
         ================================================================ -->

    <CornerRadius x:Key="RadioBordeTarjeta">8</CornerRadius>
    <CornerRadius x:Key="RadioBordeBoton">6</CornerRadius>
    <CornerRadius x:Key="RadioBordeCampo">6</CornerRadius>

<!-- ===============================================================
     ESTILOS BASE
     =============================================================== -->

    <Style x:Key="EstiloTextoBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuentePrincipal}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoPrimario}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="EstiloTituloGrande" TargetType="TextBlock" BasedOn="{StaticResource EstiloTextoBase}">
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoTituloGrande}" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteTitulos}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaPrimaria}" />
    </Style>

    <Style x:Key="EstiloTextoSecundario" TargetType="TextBlock" BasedOn="{StaticResource EstiloTextoBase}">
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoSecundario}" />
    </Style>

    <Style x:Key="EstiloTextoSuave" TargetType="TextBlock" BasedOn="{StaticResource EstiloTextoBase}">
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoPequeno}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoSuave}" />
    </Style>

    <Style x:Key="EstiloBotonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FuentePrincipal}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoNormal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadioBordeBoton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EstiloBotonPrimario" TargetType="Button" BasedOn="{StaticResource EstiloBotonBase}">
        <Setter Property="Background" Value="{DynamicResource BrochaPrimaria}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoInverso}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrochaPrimariaClara}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrochaPrimariaOscura}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BrochaBordeClaro}" />
                <Setter Property="Foreground" Value="{DynamicResource BrochaTextoSuave}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloBotonSecundario" TargetType="Button" BasedOn="{StaticResource EstiloBotonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoPrimario}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrochaBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrochaSuperficieSecundaria}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloBotonExito" TargetType="Button" BasedOn="{StaticResource EstiloBotonBase}">
        <Setter Property="Background" Value="{DynamicResource BrochaExito}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoInverso}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style x:Key="EstiloBotonPeligro" TargetType="Button" BasedOn="{StaticResource EstiloBotonBase}">
        <Setter Property="Background" Value="{DynamicResource BrochaPeligro}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoInverso}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style x:Key="EstiloCampoTexto" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FuentePrincipal}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoPrimario}" />
        <Setter Property="Background" Value="{DynamicResource BrochaSuperficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrochaBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrochaPrimaria}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloCampoFecha" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource FuentePrincipal}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoPrimario}" />
        <Setter Property="Background" Value="{DynamicResource BrochaSuperficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrochaBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrochaPrimaria}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloCampoContrasena" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource FuentePrincipal}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoPrimario}" />
        <Setter Property="Background" Value="{DynamicResource BrochaSuperficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrochaBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrochaPrimaria}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FuentePrincipal}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanoTextoNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource BrochaTextoPrimario}" />
        <Setter Property="Background" Value="{DynamicResource BrochaSuperficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrochaBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrochaPrimaria}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tarjeta de indicador -->
    <Style x:Key="EstiloTarjetaIndicador" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrochaSuperficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrochaBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBordeTarjeta}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Tarjeta de indicador con color de estado -->
    <Style x:Key="EstiloTarjetaEstado" TargetType="Border" BasedOn="{StaticResource EstiloTarjetaIndicador}">
        <Setter Property="BorderThickness" Value="0,4,0,0" />
    </Style>

</ResourceDictionary>
