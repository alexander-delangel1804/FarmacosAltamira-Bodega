<Page x:Class="Altamira.Bodega.Presentation.Views.AlertasCaducidadView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1100"
      Background="{DynamicResource BrochaFondo}">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Alertas de Caducidad" Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Supervisión de lotes por proximidad a fecha de caducidad" Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Tarjetas de resumen -->
        <Border Grid.Row="1" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BrochaPeligro}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CADUCADAS" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding TotalCaducadas}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F57C00" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PRÓXIMAS A CADUCAR" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding TotalProximas}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource BrochaPrimaria}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL ALERTAS" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding TotalAlertas}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{DynamicResource BrochaExito}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PRIORIDAD ALTA" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding PrioridadAltaCount}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="2" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CampoBusqueda}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EstiloCampoTexto}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.ToolTip>
                                <TextBlock Text="Buscar por producto, lote, ubicación o tipo" />
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Buscar"
                                Style="{DynamicResource EstiloBotonPrimario}"
                                Command="{Binding CargarAlertasCommand}"
                                Padding="16,4"
                                MinHeight="32" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Desde:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding FechaDesde, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <TextBlock Grid.Column="3" Text="Hasta:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="4" SelectedDate="{Binding FechaHasta, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <CheckBox Grid.Column="5" Content="Solo no atendidas" IsChecked="{Binding SoloNoAtendidas, Mode=TwoWay}" Style="{DynamicResource MaterialDesignCheckBox}" Margin="8,0,0,0" VerticalAlignment="Center" />

                <Button Grid.Column="6" Content="Limpiar" Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding LimpiarFiltrosCommand}" Padding="16,8" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Tabla de alertas caducadas -->
        <Border Grid.Row="3" Style="{DynamicResource EstiloTarjetaIndicador}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BrochaPeligro}" Padding="12">
                    <TextBlock Text="LOTES CADUCADOS" Foreground="White" FontWeight="Bold" Style="{DynamicResource EstiloTextoBase}" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                    <ItemsControl ItemsSource="{Binding AlertasCaducadas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}" Margin="0,4,0,0">
                                    <Grid Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FechaGeneracion, StringFormat='dd/MM/yyyy HH:mm'}" Style="{DynamicResource CeldaTabla}" Foreground="{DynamicResource BrochaPeligro}" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductoNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="2" Text="{Binding NumeroLote}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding UbicacionNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Mensaje}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Tipo}" Style="{DynamicResource CeldaTabla}" />
                                        <Button Grid.Column="6" Content="Atender" Style="{DynamicResource EstiloBotonSecundario}"
                                                Command="{Binding DataContext.MarcarAtendidaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding IdAlerta}" Padding="8,4" Margin="4,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Tabla de alertas próximas -->
        <Border Grid.Row="4" Style="{DynamicResource EstiloTarjetaIndicador}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F57C00" Padding="12">
                    <TextBlock Text="LOTES PRÓXIMOS A CADUCAR" Foreground="White" FontWeight="Bold" Style="{DynamicResource EstiloTextoBase}" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                    <ItemsControl ItemsSource="{Binding AlertasProximas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}" Margin="0,4,0,0">
                                    <Grid Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FechaGeneracion, StringFormat='dd/MM/yyyy HH:mm'}" Style="{DynamicResource CeldaTabla}" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductoNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="2" Text="{Binding NumeroLote}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding UbicacionNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Mensaje}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Tipo}" Style="{DynamicResource CeldaTabla}" />
                                        <Button Grid.Column="6" Content="Atender" Style="{DynamicResource EstiloBotonSecundario}"
                                                Command="{Binding DataContext.MarcarAtendidaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding IdAlerta}" Padding="8,4" Margin="4,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Estado vacío -->
        <Border Grid.Row="3" Grid.RowSpan="2" Style="{DynamicResource EstadoVacioContenedor}" Visibility="{Binding NoHayAlertas, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="✅" Style="{DynamicResource EstadoVacioIcono}" />
                <TextBlock Text="No hay alertas de caducidad" Style="{DynamicResource EstadoVacioTexto}" />
                <TextBlock Text="Todos los lotes están dentro de su periodo de validez." Style="{DynamicResource EstiloTextoSuave}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Mensajes -->
        <Border Grid.Row="5" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeError, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="5" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeExito, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaExito}" />
                <TextBlock Text="{Binding MensajeExito}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaExito}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
