<Page x:Class="Altamira.Bodega.Presentation.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{DynamicResource BrochaFondo}">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Dashboard de Bodega"
                   Style="{DynamicResource EstiloTituloGrande}"
                   Margin="0,0,0,24" />

        <!-- Tarjetas de indicadores (KPI) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total productos -->
            <Border Grid.Column="0" Style="{DynamicResource TarjetaKPI}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Productos" Style="{DynamicResource TarjetaKPITitulo}" />
                    <TextBlock Text="{Binding TotalProductos}" Style="{DynamicResource TarjetaKPIValor}" />
                    <TextBlock Text="en el catálogo" Style="{DynamicResource EstiloTextoSuave}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Total unidades -->
            <Border Grid.Column="1" Style="{DynamicResource TarjetaKPI}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="Unidades en Bodega" Style="{DynamicResource TarjetaKPITitulo}" />
                    <TextBlock Text="{Binding TotalUnidadesBodega}" Style="{DynamicResource TarjetaKPIValor}" />
                    <TextBlock Text="existencias totales" Style="{DynamicResource EstiloTextoSuave}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Próximos a caducar -->
            <Border Grid.Column="2" Style="{DynamicResource TarjetaKPI}" Margin="8,0,8,0"
                    BorderBrush="{DynamicResource BrochaStockProximo}" BorderThickness="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Próximos a Caducar" Style="{DynamicResource TarjetaKPITitulo}"
                               Foreground="{DynamicResource BrochaStockProximo}" />
                    <TextBlock Text="{Binding ProductosProximosCaducar}" Style="{DynamicResource TarjetaKPIValor}"
                               Foreground="{DynamicResource BrochaStockProximo}" />
                    <TextBlock Text="requieren atención" Style="{DynamicResource EstiloTextoSuave}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Caducados -->
            <Border Grid.Column="3" Style="{DynamicResource TarjetaKPI}" Margin="8,0,8,0"
                    BorderBrush="{DynamicResource BrochaPeligro}" BorderThickness="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Caducados" Style="{DynamicResource TarjetaKPITitulo}"
                               Foreground="{DynamicResource BrochaPeligro}" />
                    <TextBlock Text="{Binding ProductosCaducados}" Style="{DynamicResource TarjetaKPIValor}"
                               Foreground="{DynamicResource BrochaPeligro}" />
                    <TextBlock Text="requieren merma" Style="{DynamicResource EstiloTextoSuave}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Bajo mínimo -->
            <Border Grid.Column="4" Style="{DynamicResource TarjetaKPI}" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource BrochaAdvertencia}" BorderThickness="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Bajo Stock Mínimo" Style="{DynamicResource TarjetaKPITitulo}"
                               Foreground="{DynamicResource BrochaAdvertencia}" />
                    <TextBlock Text="{Binding ProductosBajoMinimo}" Style="{DynamicResource TarjetaKPIValor}"
                               Foreground="{DynamicResource BrochaAdvertencia}" />
                    <TextBlock Text="requieren reposición" Style="{DynamicResource EstiloTextoSuave}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Segunda fila: resumen de operaciones -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Recepciones y traslados -->
            <Border Grid.Column="0" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Operaciones Recientes" Style="{DynamicResource EstiloTextoBase}"
                               FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Recepciones" Style="{DynamicResource EstiloTextoSuave}" />
                            <TextBlock Text="{Binding RecepcionesRecientes}" Style="{DynamicResource TarjetaKPIValor}"
                                       FontSize="24" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Traslados Pend." Style="{DynamicResource EstiloTextoSuave}" />
                            <TextBlock Text="{Binding TrasladosPendientes}" Style="{DynamicResource TarjetaKPIValor}"
                                       FontSize="24" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Movimientos y alertas -->
            <Border Grid.Column="1" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Movimientos y Alertas" Style="{DynamicResource EstiloTextoBase}"
                               FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Movimientos" Style="{DynamicResource EstiloTextoSuave}" />
                            <TextBlock Text="{Binding MovimientosRecientes}" Style="{DynamicResource TarjetaKPIValor}"
                                       FontSize="24" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Alertas Activas" Style="{DynamicResource EstiloTextoSuave}" />
                            <TextBlock Text="{Binding AlertasRecientes.Count}" Style="{DynamicResource TarjetaKPIValor}"
                                       FontSize="24" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Mensaje de error -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Style="{DynamicResource NotificacionError}"
                Visibility="{Binding MensajeError, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}"
                Margin="0,24,0,0"
                VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠"
                           Style="{DynamicResource NotificacionIcono}"
                           Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}"
                           Style="{DynamicResource NotificacionTexto}"
                           Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
