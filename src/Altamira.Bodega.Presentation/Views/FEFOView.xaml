<Page x:Class="Altamira.Bodega.Presentation.Views.FEFOView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="{DynamicResource BrochaFondo}">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Control FEFO - First Expired, First Out" Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Priorización de lotes por fecha de caducidad para salida de inventario" Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Tarjetas de resumen -->
        <Border Grid.Row="1" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BrochaExito}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="LOTES ELEGIBLES" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding LotesElegibles}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F57C00" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="NO ELEGIBLES" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding LotesNoElegibles}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource BrochaPeligro}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="LOTES CADUCADOS" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding LotesCaducados}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{DynamicResource BrochaPrimaria}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL LOTES" Style="{DynamicResource EstiloTextoSuave}" Foreground="White" Opacity="0.8" />
                        <TextBlock Text="{Binding TotalLotes}" Style="{DynamicResource EstiloTituloGrande}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="2" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CampoBusqueda}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EstiloCampoTexto}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.ToolTip>
                                <TextBlock Text="Buscar por producto, lote o ubicación" />
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Buscar"
                                Style="{DynamicResource EstiloBotonPrimario}"
                                Command="{Binding CargarLotesFEFOCommand}"
                                Padding="16,4"
                                MinHeight="32" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Estado:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding FiltroEstado, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <TextBlock Grid.Column="3" Text="Desde:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="4" SelectedDate="{Binding FechaCaducidadDesde, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <TextBlock Grid.Column="5" Text="Hasta:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="6" SelectedDate="{Binding FechaCaducidadHasta, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <CheckBox Grid.Column="7" Content="Solo elegibles para salida" IsChecked="{Binding SoloElegibles, Mode=TwoWay}" Style="{DynamicResource MaterialDesignCheckBox}" Margin="8,0,0,0" VerticalAlignment="Center" />

                <Button Grid.Column="8" Content="Limpiar" Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding LimpiarFiltrosCommand}" Padding="16,8" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Tabla de lotes FEFO -->
        <Border Grid.Row="3" Style="{DynamicResource EstiloTarjetaIndicador}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezados -->
                <Border Grid.Row="0" Background="{DynamicResource BrochaSuperficieSecundaria}" BorderBrush="{DynamicResource BrochaBorde}" BorderThickness="0,0,0,1">
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Lote" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="1" Text="Producto" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="2" Text="Caducidad" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="3" Text="Días" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="4" Text="Disponible" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="5" Text="Ubicación" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="6" Text="Estado" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="7" Text="Elegibilidad" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="8" Text="Prioridad" Style="{DynamicResource EncabezadoColumnaTabla}" />
                    </Grid>
                </Border>

                <!-- Filas -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LotesFEFO}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}" Margin="0,4,0,0">
                                    <Grid Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding NumeroLote}" Style="{DynamicResource CeldaTabla}" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductoNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="2" Text="{Binding FechaCaducidad, StringFormat='dd/MM/yyyy'}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DiasHastaCaducidad}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="4" Text="{Binding CantidadDisponible, StringFormat='N0'}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="5" Text="{Binding UbicacionNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Estado}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="7" Text="{Binding Elegibilidad}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="8" Text="{Binding PrioridadScore, StringFormat='N0'}" Style="{DynamicResource CeldaTabla}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Estado vacío -->
        <Border Grid.Row="3" Style="{DynamicResource EstadoVacioContenedor}" Visibility="{Binding NoHayLotes, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="📦" Style="{DynamicResource EstadoVacioIcono}" />
                <TextBlock Text="No hay lotes registrados" Style="{DynamicResource EstadoVacioTexto}" />
                <TextBlock Text="Registre recepciones de mercancía para comenzar el control FEFO." Style="{DynamicResource EstiloTextoSuave}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Mensajes -->
        <Border Grid.Row="4" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeError, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
