<UserControl x:Class="Altamira.Bodega.Presentation.Views.KardexView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="{DynamicResource BrochaFondo}">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EstadoAlColorConverter x:Key="EstadoAlColorConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Kárdex y Movimientos de Inventario" Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Historial trazable de todas las entradas, salidas y ajustes de inventario" Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CampoBusqueda}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EstiloCampoFecha}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.ToolTip>
                                <TextBlock Text="Buscar por producto, lote, usuario o folio" />
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Buscar"
                                Style="{DynamicResource EstiloBotonPrimario}"
                                Command="{Binding CargarMovimientosCommand}"
                                Padding="16,4"
                                MinHeight="32" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Tipo:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding FiltroTipo, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="100" Margin="0,0,8,0" />

                <TextBlock Grid.Column="3" Text="Desde:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="4" SelectedDate="{Binding FechaDesde, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoFecha}" Width="120" Margin="0,0,8,0" />

                <TextBlock Grid.Column="5" Text="Hasta:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="6" SelectedDate="{Binding FechaHasta, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoFecha}" Width="120" Margin="0,0,8,0" />

                <Button Grid.Column="7" Content="Limpiar" Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding LimpiarFiltrosCommand}" Padding="16,8" Margin="8,0,0,0" />

                <Button Grid.Column="8" Content="Exportar" Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding ExportarCommand}" Padding="16,8" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Tabla de movimientos -->
        <Border Grid.Row="2" Style="{DynamicResource EstiloTarjetaIndicador}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezados -->
                <Border Grid.Row="0" Background="{DynamicResource BrochaSuperficieSecundaria}" BorderBrush="{DynamicResource BrochaBorde}" BorderThickness="0,0,0,1">
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Fecha y Hora" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="1" Text="Producto" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="2" Text="Lote" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="3" Text="Ubicación" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="4" Text="Tipo" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="5" Text="Entrada" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="6" Text="Salida" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="7" Text="Motivo" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="8" Text="Usuario" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="9" Text="Referencia" Style="{DynamicResource EncabezadoColumnaTabla}" />
                    </Grid>
                </Border>

                <!-- Filas -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Movimientos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}" Margin="0,4,0,0">
                                    <Grid Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FechaHora, StringFormat='dd/MM/yyyy HH:mm'}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductoNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="2" Text="{Binding NumeroLote}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding UbicacionNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Tipo}" Style="{DynamicResource CeldaTabla}"
                                                   Foreground="{Binding Tipo, Converter={StaticResource EstadoAlColorConverter}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Cantidad, Converter={StaticResource EstadoAlColorConverter}, ConverterParameter=entrada, StringFormat='N0'}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Cantidad, Converter={StaticResource EstadoAlColorConverter}, ConverterParameter=salida, StringFormat='N0'}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="7" Text="{Binding Motivo}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="8" Text="{Binding UsuarioNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="9" Text="{Binding DocumentoOrigen}" Style="{DynamicResource CeldaTabla}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Resumen -->
                <Border Grid.Row="2" Background="{DynamicResource BrochaSuperficieSecundaria}" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Resumen:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalMovimientos}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalEntradas}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" Foreground="{DynamicResource BrochaExito}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="{Binding TotalSalidas}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" Foreground="{DynamicResource BrochaPeligro}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Estado vacío -->
        <Border Grid.Row="2" Style="{DynamicResource EstadoVacioContenedor}" Visibility="{Binding NoHayMovimientos, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="📋" Style="{DynamicResource EstadoVacioIcono}" />
                <TextBlock Text="No hay movimientos registrados" Style="{DynamicResource EstadoVacioTexto}" />
                <TextBlock Text="Registre una recepción o ajuste para comenzar a generar historial." Style="{DynamicResource EstiloTextoSuave}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Paginación -->
        <Border Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,8,16,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Anterior" Command="{Binding CambiarPaginaCommand}" CommandParameter="-1"
                        Style="{DynamicResource EstiloBotonSecundario}" IsEnabled="{Binding TieneAnterior}" Padding="12,6" Margin="0,0,4,0" />
                <TextBlock Text="{Binding PaginaActual}" Style="{DynamicResource EstiloTextoSuave}" VerticalAlignment="Center" Margin="8,0" />
                <Button Content="Siguiente" Command="{Binding CambiarPaginaCommand}" CommandParameter="1"
                        Style="{DynamicResource EstiloBotonSecundario}" IsEnabled="{Binding TieneSiguiente}" Padding="12,6" Margin="4,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Mensaje de error -->
        <Border Grid.Row="4"
                Style="{DynamicResource NotificacionError}"
                Visibility="{Binding HayMensajeError, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Panel.ZIndex="10"
                Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>

        <!-- Mensaje de éxito -->
        <Border Grid.Row="4"
                Style="{DynamicResource NotificacionError}"
                Visibility="{Binding HayMensajeExito, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Panel.ZIndex="10"
                Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaExito}" />
                <TextBlock Text="{Binding MensajeExito}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaExito}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
