<UserControl x:Class="Altamira.Bodega.Presentation.Views.LoteInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="600"
      Background="{DynamicResource BrochaFondo}">

<UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EstadoAlColorConverter x:Key="EstadoAlColorConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Información de Lote"
                       Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Detalle de lote, caducidad y existencias"
                       Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{DynamicResource EstiloTarjetaIndicador}"
                Margin="0,0,0,16">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Producto -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Producto:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Producto.NombreComercial}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Código de barras -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Código de Barras:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Producto.CodigoBarras}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Número de lote -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Número de Lote:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Lote.NumeroLote}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Fecha de caducidad -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha de Caducidad:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Lote.FechaCaducidad, StringFormat='dd/MM/yyyy'}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Fecha de ingreso -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Fecha de Ingreso:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Lote.FechaIngreso, StringFormat='dd/MM/yyyy'}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Estado -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Estado:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EstadoTexto}" Style="{DynamicResource EstiloTextoBase}"
                           Foreground="{Binding EstadoTexto, Converter={StaticResource EstadoAlColorConverter}}" />

                <!-- Días hasta caducidad -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Días hasta caducidad:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DiasHastaCaducidadTexto}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Cantidad disponible -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Cantidad Disponible:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Existencia.Disponible, StringFormat='N0 unidades'}" Style="{DynamicResource EstiloTextoBase}" />

                <!-- Valor del inventario -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Valor del Inventario:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ValorInventario, StringFormat='C2'}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24">
            <TextBlock Text="La información se obtiene de la API central de Fármacos Altamira"
                       Style="{DynamicResource EstiloTextoSuave}" />
        </Border>
    </Grid>
</UserControl>
