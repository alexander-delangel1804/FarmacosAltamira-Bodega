<UserControl x:Class="Altamira.Bodega.Presentation.Views.ProductoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1100"
      Background="{DynamicResource BrochaFondo}">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Catálogo de Productos"
                       Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Administración de catálogo de productos y existencias"
                       Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Barra de herramientas -->
        <Border Grid.Row="1"
                Style="{DynamicResource EstiloTarjetaIndicador}"
                Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Búsqueda -->
                <Border Grid.Column="0" Style="{DynamicResource CampoBusqueda}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="TxtBusqueda"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EstiloCampoTexto}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.ToolTip>
                                <TextBlock Text="Buscar por nombre, código de barras o sustancia activa" />
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Buscar"
                                Style="{DynamicResource EstiloBotonPrimario}"
                                Command="{Binding BuscarCommand}"
                                Padding="16,4"
                                MinHeight="32" />
                    </Grid>
                </Border>

                <!-- Filtro solo activos -->
                <CheckBox Grid.Column="1" Margin="8,0,0,0"
                          Content="Solo activos"
                          IsChecked="{Binding SoloActivos, Mode=TwoWay}"
                          Style="{DynamicResource MaterialDesignCheckBox}" />

                <Button Grid.Column="2" Margin="8,0,8,0"
                        Content="Refrescar"
                        Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding RefrescarCommand}"
                        Padding="16,8"
                        MinHeight="40" />

                <Button Grid.Column="3"
                        Content="+ Nuevo Producto"
                        Style="{DynamicResource EstiloBotonPrimario}"
                        Command="{Binding AbrirCreacionCommand}"
                        Padding="16,8"
                        MinHeight="40" />
            </Grid>
        </Border>

        <!-- Tabla de productos -->
        <Border Grid.Row="2"
                Style="{DynamicResource ContenedorTabla}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezados -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrochaSuperficieSecundaria}"
                        BorderBrush="{DynamicResource BrochaBorde}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Código de Barras" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="1" Text="Nombre Comercial" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="2" Text="Sustancia Activa" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="3" Text="Presentación" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="4" Text="Precio Venta" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="5" Text="Stock Mínimo" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="6" Text="Controlado" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="7" Text="Estado" Style="{DynamicResource EncabezadoColumnaTabla}" />
                    </Grid>
                </Border>

                <!-- Filas -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Productos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}"
                                        MouseLeftButtonDown="Producto_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding CodigoBarras}"
                                                   Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NombreComercial}"
                                                   Style="{DynamicResource CeldaTabla}"
                                                   ToolTip="{Binding NombreComercial}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SustanciaActiva}"
                                                   Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Presentacion}"
                                                   Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="4" Text="{Binding PrecioVenta, StringFormat='C2'}"
                                                   Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="5" Text="{Binding StockMinimo}"
                                                   Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="6" Text="{Binding EsControlado, Converter={StaticResource BoolToVis}, ConverterParameter=SI_NO}"
                                                   Style="{DynamicResource CeldaTabla}" />
                                        <Border Grid.Column="7">
                                            <TextBlock Text="{Binding Activo, Converter={StaticResource BoolToVis}, ConverterParameter=ACTIVO_INACTIVO}"
                                                       Style="{DynamicResource EtiquetaEstadoTexto}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Paginación -->
        <Border Grid.Row="2"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,8,16,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Anterior"
                        Command="{Binding CambiarPaginaCommand}"
                        CommandParameter="-1"
                        Style="{DynamicResource EstiloBotonSecundario}"
                        IsEnabled="{Binding TieneAnterior}"
                        Padding="12,6"
                        Margin="0,0,4,0" />
                <TextBlock Text="{Binding PaginaActual, StringFormat='Página {0}'}"
                           Style="{DynamicResource EstiloTextoSuave}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <Button Content="Siguiente"
                        Command="{Binding CambiarPaginaCommand}"
                        CommandParameter="1"
                        Style="{DynamicResource EstiloBotonSecundario}"
                        IsEnabled="{Binding TieneSiguiente}"
                        Padding="12,6"
                        Margin="4,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Mensaje vacío -->
        <Border Grid.Row="2"
                Style="{DynamicResource EstadoVacioContenedor}"
                Visibility="{Binding Productos.Count, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}">
            <StackPanel>
                <TextBlock Text="📦"
                           Style="{DynamicResource EstadoVacioIcono}" />
                <TextBlock Text="No hay productos registrados"
                           Style="{DynamicResource EstadoVacioTexto}" />
                <TextBlock Text="Registre un nuevo producto para comenzar."
                           Style="{DynamicResource EstiloTextoSuave}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Error -->
        <Border Grid.Row="2"
                Style="{DynamicResource NotificacionError}"
                Visibility="{Binding MensajeError, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Panel.ZIndex="10"
                Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠"
                           Style="{DynamicResource NotificacionIcono}"
                           Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}"
                           Style="{DynamicResource NotificacionTexto}"
                           Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
