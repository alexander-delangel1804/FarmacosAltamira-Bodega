<Window x:Class="Altamira.Bodega.Presentation.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bodega - Fármacos Altamira"
        Height="768"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        MinWidth="1024"
        MinHeight="720"
        Background="{DynamicResource BrochaFondo}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- MENÚ LATERAL -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource BrochaSuperficie}"
                BorderBrush="{DynamicResource BrochaBorde}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Height="64"
                        Background="{DynamicResource BrochaPrimaria}"
                        Padding="16">
                    <TextBlock Text="BODEGA"
                               FontFamily="{DynamicResource FuenteTitulos}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrochaTextoInverso}"
                               VerticalAlignment="Center" />
                </Border>

                <Border DockPanel.Dock="Bottom"
                        Height="140"
                        Background="{DynamicResource BrochaSuperficieSecundaria}"
                        Padding="16"
                        BorderBrush="{DynamicResource BrochaBorde}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Sesión"
                                   Style="{DynamicResource EstiloTextoSuave}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="TxtUsuarioSesion"
                                   Text="Empleado de Bodega"
                                   Style="{DynamicResource EstiloTextoBase}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtUbicacionSesion"
                                   Text="Bodega Central"
                                   Style="{DynamicResource EstiloTextoSuave}" />
                    </StackPanel>
                </Border>

                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="INICIO"
                                   Style="{DynamicResource TituloSeccionMenu}" />

                        <Button Content="📊  Dashboard"
                                Style="{DynamicResource ItemMenuLateralSeleccionado}"
                                Command="{Binding NavigateToDashboardCommand}" />

                        <TextBlock Text="INVENTARIO"
                                   Style="{DynamicResource TituloSeccionMenu}" />

                        <Button Content="📦  Existencias por Ubicación"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToExistenciasCommand}" />
                        <Button Content="📋  Catálogo de Productos"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToCatalogoCommand}" />
                        <Button Content="⏰  Lotes y Caducidades"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToLotesCommand}" />
                        <Button Content="📈  Kárdex y Movimientos"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToKardexCommand}" />
                        <Button Content="⚖️  Ajustes de Inventario"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToAjustesCommand}" />

                        <TextBlock Text="OPERACIONES"
                                   Style="{DynamicResource TituloSeccionMenu}" />

                        <Button Content="📥  Recepción de Mercancía"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToRecepcionCommand}" />
                        <Button Content="➕  Entradas de Inventario"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToEntradasCommand}" />
                        <Button Content="➖  Salidas de Inventario"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToSalidasCommand}" />
                        <Button Content="🚚  Traslados"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToTrasladosCommand}" />

                        <TextBlock Text="CONTROL"
                                   Style="{DynamicResource TituloSeccionMenu}" />

                        <Button Content="⚠️  Alertas de Caducidad"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToAlertasCaducidadCommand}" />
                        <Button Content="📉  Alertas de Stock Mínimo"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToAlertasStockCommand}" />
                        <Button Content="📋  Bitácora de Operaciones"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToBitacoraCommand}" />

                        <TextBlock Text="ADMINISTRACIÓN"
                                   Style="{DynamicResource TituloSeccionMenu}" />

                        <Button Content="👥  Usuarios y Permisos"
                                Style="{DynamicResource ItemMenuLateral}"
                                Command="{Binding NavigateToUsuariosCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ENCABEZADO SUPERIOR -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource BrochaSuperficie}"
                BorderBrush="{DynamicResource BrochaBorde}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding TituloPaginaActual}"
                           Style="{DynamicResource EstiloTituloGrande}"
                               VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Margin="24,0"
                        Padding="8,4"
                        Background="{DynamicResource BrochaSuperficieSecundaria}"
                        CornerRadius="20">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="IndicadorConexion"
                                Style="{DynamicResource IndicadorConexion}"
                                Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtEstadoConexion"
                                   Text="Conectado"
                                   Style="{DynamicResource IndicadorConexionTexto}" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Margin="16,0,0,0"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Notificaciones">
                    <TextBlock Text="𔔇"
                               FontSize="20"
                               Foreground="{DynamicResource BrochaTextoSecundario}" />
                </Button>

                <Button Grid.Column="3"
                        Margin="16,0,0,0"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Cuenta de usuario"
                        Command="{Binding CerrarSesionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤"
                                   FontSize="18"
                                   Foreground="{DynamicResource BrochaTextoSecundario}"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Salir"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrochaPeligro}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ÁREA DE CONTENIDO CENTRAL -->
        <ContentControl Grid.Row="1" Grid.Column="1"
               x:Name="ContentArea"
               Margin="24" />

        <!-- BARRA DE ESTADO -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource BrochaSuperficie}"
                BorderBrush="{DynamicResource BrochaBorde}"
                BorderThickness="0,1,0,0"
                Padding="24,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Fármacos Altamira - Módulo de Bodega e Inventario"
                           Style="{DynamicResource EstiloTextoSuave}" />

                <TextBlock Grid.Column="1"
                           Text="Versión 1.0.0"
                           Style="{DynamicResource EstiloTextoSuave}"
                               Margin="24,0,0,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding FechaHoraActual, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                           Style="{DynamicResource EstiloTextoSuave}"
                               Margin="24,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
