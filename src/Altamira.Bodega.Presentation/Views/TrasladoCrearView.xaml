<Page x:Class="Altamira.Bodega.Presentation.Views.TrasladoCrearView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1100"
      Background="{DynamicResource BrochaFondo}">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Solicitud de Traslado" Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Registro de envío de mercancía entre ubicaciones" Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Ubicaciones -->
        <Border Grid.Row="1" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Origen:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding IdOrigen}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,24,0" />

                <TextBlock Grid.Column="2" Text="Destino:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding IdDestino, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="100" />
            </Grid>
        </Border>

        <!-- Detalles del traslado -->
        <Border Grid.Row="2" Style="{DynamicResource EstiloTarjetaIndicador}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezados -->
                <Border Grid.Row="0" Background="{DynamicResource BrochaSuperficieSecundaria}" BorderBrush="{DynamicResource BrochaBorde}" BorderThickness="0,0,0,1">
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Producto" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="1" Text="Lote" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="2" Text="Existencia Disponible" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="3" Text="Cantidad a Enviar" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="4" Text="Acciones" Style="{DynamicResource EncabezadoColumnaTabla}" />
                    </Grid>
                </Border>

                <!-- Filas de detalles -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl ItemsSource="{Binding Detalles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}" Margin="0,4,0,0">
                                    <Grid Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding IdLote}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="1" Text="{Binding IdLote}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="2" Text="N/A" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding CantidadEnviada, StringFormat='N0'}" Style="{DynamicResource CeldaTabla}" />
                                        <Button Grid.Column="4" Content="Eliminar" Style="{DynamicResource EstiloBotonSecundario}"
                                                Command="{Binding DataContext.QuitarDetalleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="8,4" Margin="4,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Resumen -->
                <Border Grid.Row="2" Background="{DynamicResource BrochaSuperficieSecundaria}" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Resumen:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalDetalles}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalCantidad}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Estado vacío de detalles -->
        <Border Grid.Row="2" Style="{DynamicResource EstadoVacioContenedor}" Visibility="{Binding HayDetalles, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}">
            <StackPanel>
                <TextBlock Text="📦" Style="{DynamicResource EstadoVacioIcono}" />
                <TextBlock Text="No hay productos en el traslado" Style="{DynamicResource EstadoVacioTexto}" />
                <TextBlock Text="Agregue productos con lotes para continuar." Style="{DynamicResource EstiloTextoSuave}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Formulario para agregar producto -->
        <Border Grid.Row="3" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,16,0,0">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Producto:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding NombreProductoSeleccionado, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="200" Margin="0,0,16,0" />

                <TextBlock Grid.Column="2" Text="Lote:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding NumeroLoteSeleccionado, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,16,0" />

                <TextBlock Grid.Column="4" Text="Disponible:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding ExistenciaDisponible, StringFormat='N0'}" Style="{DynamicResource EstiloTextoBase}" FontWeight="Bold" Margin="0,0,16,0" />

                <TextBlock Grid.Column="6" Text="Cantidad:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="7" Text="{Binding CantidadEnviar, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="80" Margin="0,0,16,0" />

                <Button Grid.Column="8" Content="Agregar" Style="{DynamicResource EstiloBotonPrimario}" Command="{Binding AgregarDetalleCommand}" Padding="16,8" Margin="8,0,0,0" IsEnabled="{Binding PuedeAgregarDetalle}" />
            </Grid>
        </Border>

        <!-- Observaciones y botón solicitar -->
        <Border Grid.Row="4" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,16,0,0">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Observaciones:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" />

                <Button Grid.Column="1" Content="Limpiar Todo" Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding LimpiarTodoCommand}" Padding="16,12" MinWidth="120" Margin="0,0,16,0" />
                <Button Grid.Column="2" Content="Solicitar Traslado" Style="{DynamicResource EstiloBotonPrimario}"
                        Command="{Binding SolicitarTrasladoCommand}" Padding="24,12" MinWidth="160"
                        IsEnabled="{Binding HayDetalles}" />
            </Grid>
        </Border>

        <!-- Mensajes -->
        <Border Grid.Row="5" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeError, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="5" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeExito, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaExito}" />
                <TextBlock Text="{Binding MensajeExito}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaExito}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
