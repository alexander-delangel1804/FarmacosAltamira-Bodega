<Page x:Class="Altamira.Bodega.Presentation.Views.TrasladoHistorialView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      xmlns:local="clr-namespace:Altamira.Bodega.Presentation.Resources"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="{DynamicResource BrochaFondo}">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Historial de Traslados" Style="{DynamicResource EstiloTituloGrande}" />
            <TextBlock Text="Consulta de traslados entre ubicaciones con filtros" Style="{DynamicResource EstiloTextoSuave}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{DynamicResource EstiloTarjetaIndicador}" Margin="0,0,0,16">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CampoBusqueda}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EstiloCampoTexto}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.ToolTip>
                                <TextBlock Text="Buscar por folio, origen, destino, usuario o producto" />
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Buscar"
                                Style="{DynamicResource EstiloBotonPrimario}"
                                Command="{Binding CargarTrasladosCommand}"
                                Padding="16,4"
                                MinHeight="32" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Estado:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding FiltroEstado, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="100" Margin="0,0,8,0" />

                <TextBlock Grid.Column="3" Text="Desde:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="4" SelectedDate="{Binding FechaDesde, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <TextBlock Grid.Column="5" Text="Hasta:" Style="{DynamicResource EstiloTextoSuave}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <DatePicker Grid.Column="6" SelectedDate="{Binding FechaHasta, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource EstiloCampoTexto}" Width="120" Margin="0,0,8,0" />

                <Button Grid.Column="7" Content="Limpiar" Style="{DynamicResource EstiloBotonSecundario}"
                        Command="{Binding LimpiarFiltrosCommand}" Padding="16,8" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Tabla de historial -->
        <Border Grid.Row="2" Style="{DynamicResource EstiloTarjetaIndicador}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezados -->
                <Border Grid.Row="0" Background="{DynamicResource BrochaSuperficieSecundaria}" BorderBrush="{DynamicResource BrochaBorde}" BorderThickness="0,0,0,1">
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Folio" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="1" Text="Origen" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="2" Text="Destino" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="3" Text="Fecha" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="4" Text="Estado" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="5" Text="Usuario" Style="{DynamicResource EncabezadoColumnaTabla}" />
                        <TextBlock Grid.Column="6" Text="Observaciones" Style="{DynamicResource EncabezadoColumnaTabla}" />
                    </Grid>
                </Border>

                <!-- Filas -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Traslados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource FilaTabla}" Margin="0,4,0,0">
                                    <Grid Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Folio}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OrigenNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DestinoNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FechaSolicitud, StringFormat='dd/MM/yyyy HH:mm'}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Estado}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="5" Text="{Binding UsuarioSolicitaNombre}" Style="{DynamicResource CeldaTabla}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Observaciones}" Style="{DynamicResource CeldaTabla}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Estado vacío -->
        <Border Grid.Row="2" Style="{DynamicResource EstadoVacioContenedor}" Visibility="{Binding TotalTraslados, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}">
            <StackPanel>
                <TextBlock Text="📋" Style="{DynamicResource EstadoVacioIcono}" />
                <TextBlock Text="No hay traslados registrados" Style="{DynamicResource EstadoVacioTexto}" />
                <TextBlock Text="Cree una solicitud de traslado para comenzar el historial." Style="{DynamicResource EstiloTextoSuave}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Mensajes -->
        <Border Grid.Row="3" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeError, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaPeligro}" />
                <TextBlock Text="{Binding MensajeError}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaPeligro}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{DynamicResource NotificacionError}" Visibility="{Binding HayMensajeExito, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="10" Width="400">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" Style="{DynamicResource NotificacionIcono}" Foreground="{DynamicResource BrochaExito}" />
                <TextBlock Text="{Binding MensajeExito}" Style="{DynamicResource NotificacionTexto}" Foreground="{DynamicResource BrochaExito}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
